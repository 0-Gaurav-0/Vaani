# Copy to .env and paste your keys after the equals sign.
# .env is gitignored — never commit it.
GROQ_API_KEY=

# Optional: Gemini dictation (opt-in) and meeting transcription.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Set to 1 to enable Gemini dictation. A key alone does not enable it.
VAANI_USE_GEMINI=0
# Optional model override (default gemini-2.5-flash)
# VAANI_GEMINI_MODEL=gemini-2.5-flash

# Optional assistant routing through OpenRouter.
OPENROUTER_API_KEY=
