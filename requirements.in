# Runtime and test dependencies for Ubuntu 22.04 / Python 3.10 / x86_64.
# PyGObject is intentionally supplied by the verified system installation.
httpx
keyring
python-xlib
# Already a transitive dep of keyring->secretstorage on Linux; declared
# directly because platform/linux/wayland/portal.py imports it for the
# XDG Desktop Portal (GlobalShortcuts) D-Bus calls.
jeepney
# Post-record FLAC upload compression (libsndfile via soundfile).
numpy
soundfile
pytest
#
# macOS (Darwin): do not install python-xlib. Use the packaging extra instead:
#   uv pip install -e '.[macos]'
# which pulls sounddevice, pyperclip, and pynput (see pyproject.toml).
